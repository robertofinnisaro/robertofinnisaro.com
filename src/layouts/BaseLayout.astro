---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const { title='The Maker’s Archive', description='Projects, 3D printing, research and notes.' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="generator" content={Astro.generator}/><title>{title}</title></head><body><Header/><main><slot/></main><Footer/></body></html>
