---
interface Props {
  title?: string;
  items: { label: string; value?: string | number | null }[];
}

const { title, items } = Astro.props;
// Fields left out of the frontmatter are skipped rather than shown as blanks.
const shown = items.filter(({ value }) => value !== undefined && value !== null && value !== '');
---

{shown.length > 0 && (
  <section class="spec">
    {title && <h2>{title}</h2>}
    <dl>
      {shown.map(({ label, value }) => (
        <div><dt>{label}</dt><dd>{value}</dd></div>
      ))}
    </dl>
  </section>
)}

<style>
  .spec { padding: 1.3rem 1.4rem; border: 1px solid var(--line); background: var(--panel); }
  .spec h2 { margin: 0 0 .8rem; font-size: 1.5rem; }
  .spec dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr)); gap: 1rem 1.5rem; margin: 0; }
  .spec dt { color: var(--gold); font-size: .68rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .spec dd { margin: .2rem 0 0; color: var(--ink); font-variant-numeric: tabular-nums; }
</style>
