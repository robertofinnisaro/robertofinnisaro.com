---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import MetricsRow from '../components/MetricsRow.astro';
import { cvAvailable, cvPath, education, owner, profiles } from '../lib/site';
import { institution, position } from '../lib/teaching';

// Research interests are the topics the publications are tagged with, most
// frequent first, so the list stays current as papers are added.
const publications = await getCollection('publications', ({ data }) => !data.draft);
const tagCounts = new Map<string, number>();
for (const tag of publications.flatMap(({ data }) => data.tags)) {
  tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const interests = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag)
  .slice(0, 10);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: owner.name,
  jobTitle: position,
  worksFor: { '@type': 'CollegeOrUniversity', name: institution },
  alumniOf: education.map(({ institution }) => ({ '@type': 'CollegeOrUniversity', name: institution })),
  hasCredential: education.map(({ degree, classification }) => ({
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'degree',
    name: `${degree}, ${classification}`,
  })),
  url: Astro.site?.href,
  sameAs: profiles.map(({ href }) => href),
};
---

<BaseLayout title="About" description={`About ${owner.name}: research, profiles and CV.`}>
  <script type="application/ld+json" set:html={JSON.stringify(person)} />

  <section class="container about-head">
    <p class="eyebrow">About</p>
    <h1>{owner.name}</h1>
    <p class="about-role">{position}, {institution} · <abbr title="Associate Fellow of the Higher Education Academy">AFHEA</abbr> · MEng (Hons)</p>
    <p class="about-lead">
      Research in brain–computer interfaces and assistive technology, alongside engineering
      projects, long-form infrastructure documentation and 3D printing.
    </p>
  </section>

  <section class="container about-links" aria-label="Profiles and CV">
    {profiles.map(({ label, detail, href }) => (
      <a class="card about-link" href={href} rel="me noreferrer" target="_blank">
        <p class="eyebrow">{label}</p>
        <p class="about-link__detail">{detail} ↗</p>
      </a>
    ))}

    {cvAvailable ? (
      <a class="card about-link" href={cvPath} download>
        <p class="eyebrow">Curriculum vitae</p>
        <p class="about-link__detail">Download CV (PDF)</p>
      </a>
    ) : (
      <div class="card about-link about-link--pending">
        <p class="eyebrow">Curriculum vitae</p>
        <p class="about-link__detail">PDF coming soon</p>
      </div>
    )}
  </section>

  <section class="container about-metrics"><MetricsRow /></section>

  <section class="container about-body">
    <div class="prose">
      <h2>Education</h2>
      <ul class="education">
        {education.map(({ degree, classification, institution }) => (
          <li>
            <span class="education__degree">{degree}</span>
            <span class="education__detail">{classification} · {institution}</span>
          </li>
        ))}
      </ul>

      {interests.length > 0 && (
        <>
          <h2>Research interests</h2>
          <ul class="interests">
            {interests.map((interest) => <li>{interest}</li>)}
          </ul>
        </>
      )}

      <h2>About this site</h2>
      <p>
        This site brings together research and publications, engineering projects, teaching
        material, a book in progress on building a home lab, and a database of the 3D printers,
        filaments and print profiles in use around the house.
      </p>
      <p>
        It is generated by Astro from Markdown files, committed to Git and deployed as static
        HTML on Cloudflare Pages. The visual direction draws on dwarven halls, workshop ledgers
        and carved stone, without reproducing protected franchise artwork.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-head { padding: 5rem 0 2.5rem; }
  .about-role { margin: -.3rem 0 1rem; color: var(--ink-soft); font-family: var(--serif-text); font-size: 1.25rem; font-style: italic; }
  .about-role abbr { text-decoration: none; }
  .about-lead { max-width: 640px; font-size: 1.2rem; line-height: 1.7; color: var(--ink-soft); }
  .about-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1rem; }
  .about-link { min-height: 0; }
  .about-link .eyebrow { margin: 0 0 .4rem; }
  .about-link__detail { margin: 0; color: var(--ink); font-size: 1.02rem; overflow-wrap: anywhere; }
  .about-link--pending { border-style: dashed; }
  .about-link--pending:hover { transform: none; border-color: var(--line-soft); }
  .about-link--pending .about-link__detail { color: var(--muted); }
  .about-metrics { padding-top: 2.5rem; }
  .about-body { padding-top: 2rem; }
  .about-body .prose { margin: 0; }
  .education { padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .education li { display: flex; flex-direction: column; padding: .8rem 0; border-bottom: 1px solid var(--line-soft); }
  .education__degree { color: var(--ink); font-family: var(--serif-display); font-size: 1.35rem; font-weight: 600; }
  .education__detail { color: var(--muted); font-family: var(--sans); font-size: .9rem; }
  .interests { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; }
  .interests li { padding: .25rem .7rem; border: 1px solid var(--line); font-family: var(--sans); font-size: .85rem; }
</style>
