---
import { getCollection } from 'astro:content';
import ListingPage from '../../components/ListingPage.astro';
const entries=(await getCollection('projects',({data})=>!data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
---
<ListingPage title="Works" eyebrow="Portfolio" intro="Software, fabrication and research projects documented from first question to final result." entries={entries} base="projects" />
