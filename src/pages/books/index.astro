---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

const books = (await getCollection('books', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const statusLabels = { planned: 'Planned', drafting: 'In progress', published: 'Published' };
---

<BaseLayout title="Books" description="Long-form technical writing by Robert Finnis.">
  <section class="container page-head">
    <p class="eyebrow">Long-form writing</p>
    <h1>Books</h1>
    <p>Technical books written in the open, chapter by chapter, with their reference material alongside.</p>
  </section>

  <section class="container books">
    {books.map((book) => (
      <a class="card book-card" href={`/books/${book.id}/`}>
        <p class="eyebrow">{statusLabels[book.data.status]}</p>
        <h2>{book.data.title}</h2>
        {book.data.subtitle && <p class="book-card__subtitle">{book.data.subtitle}</p>}
        <p>{book.data.description}</p>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .page-head { padding: 5rem 0 2.5rem; }
  .page-head > p:last-child { max-width: 650px; font-size: 1.15rem; }
  .books { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: 1rem; }
  .book-card h2 { font-size: 2.2rem; margin-bottom: .2rem; }
  .book-card__subtitle { margin: 0 0 1rem; color: var(--ink-soft); font-family: var(--serif-text); font-style: italic; }
</style>
