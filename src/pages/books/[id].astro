---
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getChapters,
  getEntryUrl,
  getReferences,
  getSystemEntries,
  getSystemHub,
  groupChaptersByPart,
  groupReferences,
  type BookEntry,
} from '../../lib/systems';

export async function getStaticPaths() {
  const books = await getCollection('books', ({ data }) => !data.draft);
  return books.map((book) => ({ params: { id: book.id }, props: { book } }));
}

interface Props {
  book: BookEntry;
}

const { book } = Astro.props;
const { Content } = await render(book);

const systemId = book.data.system;
const hub = await getSystemHub(systemId);
const entries = await getSystemEntries(systemId);
const chapters = getChapters(entries);
const parts = groupChaptersByPart(systemId, chapters);
const referenceGroups = groupReferences(getReferences(entries));
const firstChapter = chapters[0];

const statusLabels = { planned: 'Planned', drafting: 'In progress', published: 'Published' };
---

<BaseLayout title={book.data.title} description={book.data.description}>
  <section class="container book-head">
    <div class="cover" aria-hidden="true">
      <div class="cover__frame">
        <span class="cover__diamond"></span>
        <p class="cover__title">{book.data.title}</p>
        {book.data.subtitle && <p class="cover__subtitle">{book.data.subtitle}</p>}
        <p class="cover__author">Robert Finnis</p>
      </div>
    </div>

    <div>
      <p class="eyebrow">Book · {statusLabels[book.data.status]}</p>
      <h1>{book.data.title}</h1>
      {book.data.subtitle && <p class="book-subtitle">{book.data.subtitle}</p>}
      <p class="book-description">{book.data.description}</p>
      <dl class="book-facts">
        <div><dt>Chapters</dt><dd>{chapters.length}</dd></div>
        <div><dt>Parts</dt><dd>{parts.filter(({ part }) => part > 0).length}</dd></div>
        <div><dt>Built on</dt><dd><a href={`/systems/${systemId}/`}>{hub.data.title}</a></dd></div>
      </dl>
      <div class="actions">
        {firstChapter && <a class="button button--primary" href={getEntryUrl(firstChapter)}>Start reading</a>}
        <a class="button" href="#contents">Contents</a>
        <a class="button" href={`/systems/${systemId}/reference/`}>Reference library</a>
      </div>
    </div>
  </section>

  <section class="container book-intro">
    <div class="rule" aria-hidden="true"><span></span></div>
    <div class="prose"><Content /></div>
  </section>

  <section class="container book-contents" id="contents">
    <p class="eyebrow">Contents</p>
    <h2>Table of contents</h2>

    {parts.map(({ part, title, entries }) => (
      <section class="book-part">
        <h3>{title}</h3>
        <ol>
          {entries.map((chapter) => (
            <li>
              <a href={getEntryUrl(chapter)}>
                <span class="book-part__number">{part > 0 ? chapter.data.chapter : ''}</span>
                <span class="book-part__title">{chapter.data.title}</span>
                <span class="book-part__time">{chapter.data.estimatedTime}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>

  <section class="container book-reference">
    <div class="section-head">
      <div>
        <p class="eyebrow">Companion material</p>
        <h2>Reference library</h2>
      </div>
      <a href={`/systems/${systemId}/reference/`}>All reference →</a>
    </div>
    <p class="book-reference__intro">
      Configurations, inventories, addressing and procedures that the chapters link to,
      kept current as the lab changes.
    </p>
    <ul class="book-reference__groups">
      {referenceGroups.map(({ title, entries }) => (
        <li>
          <a href={`/systems/${systemId}/reference/#${title.toLowerCase()}`}>
            <span>{title}</span>
            <span class="book-reference__count">{entries.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .book-head { display: grid; grid-template-columns: 300px 1fr; gap: 4rem; align-items: center; padding: 5rem 0 3rem; }
  .cover { aspect-ratio: 2 / 3; padding: 14px; border: 1px solid var(--gold); background: var(--panel); }
  .cover__frame { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; padding: 1.5rem; border: 1px solid var(--line); text-align: center; clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0 calc(100% - 14px), 0 14px); }
  .cover__diamond { width: 14px; height: 14px; margin-bottom: 1.5rem; border: 1px solid var(--gold); transform: rotate(45deg); }
  .cover__title { margin: 0; color: var(--ink); font-family: var(--serif-display); font-size: 2.2rem; font-weight: 700; line-height: 1.05; }
  .cover__subtitle { margin: .8rem 0 0; font-family: var(--serif-text); font-size: .9rem; font-style: italic; }
  .cover__author { margin: auto 0 0; color: var(--gold); font-size: .72rem; letter-spacing: .2em; text-transform: uppercase; }
  .book-subtitle { margin: -.3rem 0 1rem; color: var(--ink-soft); font-family: var(--serif-text); font-size: 1.25rem; font-style: italic; }
  .book-description { max-width: 620px; font-size: 1.05rem; }
  .book-facts { display: flex; flex-wrap: wrap; gap: 2rem; margin: 1.5rem 0 0; }
  .book-facts div { padding-left: 1rem; border-left: 1px solid var(--gold); }
  .book-facts dt { color: var(--muted); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; }
  .book-facts dd { margin: 0; font-family: var(--serif-display); font-size: 1.6rem; font-weight: 600; }
  .book-facts a { text-decoration: none; }
  .actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2rem; }
  .book-intro { padding: 2rem 0 1rem; }
  .book-intro .prose { margin-top: 2.5rem; }
  .book-contents { max-width: 820px; padding: 3rem 0; scroll-margin-top: 80px; }
  .book-part { margin-top: 2.2rem; }
  .book-part h3 { color: var(--gold); font-family: var(--sans); font-size: .76rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .book-part ol { margin: 0; padding: 0; list-style: none; }
  .book-part a { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 1rem; align-items: baseline; padding: .7rem 0; border-bottom: 1px dotted var(--line); text-decoration: none; }
  .book-part a:hover .book-part__title { color: var(--gold); }
  .book-part__number { color: var(--gold); font-family: var(--serif-display); font-size: 1.3rem; font-variant-numeric: tabular-nums; }
  .book-part__title { font-family: var(--serif-display); font-size: 1.35rem; font-weight: 600; transition: color .2s ease; }
  .book-part__time { color: var(--muted); font-size: .8rem; }
  .book-reference { padding: 3rem 0; }
  .book-reference__intro { max-width: 620px; margin-top: -1rem; }
  .book-reference__groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: .7rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .book-reference__groups a { display: flex; justify-content: space-between; padding: .8rem 1rem; border: 1px solid var(--line); background: var(--panel); text-decoration: none; }
  .book-reference__groups a:hover { border-color: var(--line-strong); }
  .book-reference__count { color: var(--gold); font-variant-numeric: tabular-nums; }
  @media (max-width: 800px) {
    .book-head { grid-template-columns: 1fr; gap: 2rem; padding-top: 3rem; }
    .cover { max-width: 220px; }
    .cover__title { font-size: 1.7rem; }
    .book-part a { grid-template-columns: 2rem 1fr; }
    .book-part__time { display: none; }
  }
</style>
