---
import {
  getCollection,
  type CollectionEntry,
} from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const publications = await getCollection(
    'publications',
    ({ data }) => !data.draft,
  );

  return publications.map((publication) => ({
    params: {
      slug: publication.slug,
    },
    props: {
      publication,
    },
  }));
}

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { Content } = await publication.render();

const {
  title,
  abstract,
  authors,
  published,
  updated,
  publicationType,
  venue,
  publisher,
  volume,
  issue,
  pages,
  doi,
  url,
  pdf,
  repository,
  citation,
  bibtex,
  tags,
} = publication.data;

const formattedDate = published.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updated?.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const publicationDetails = [
  venue,
  publisher,
  volume ? `Volume ${volume}` : undefined,
  issue ? `Issue ${issue}` : undefined,
  pages ? `Pages ${pages}` : undefined,
].filter(Boolean);
---

<BaseLayout title={title} description={abstract}>
  <main class="publication-page">
    <article>
      <header class="publication-header">
        <p class="eyebrow">{publicationType}</p>
        <h1>{title}</h1>

        <p class="abstract">{abstract}</p>

        <div class="publication-meta">
          <p>
            <strong>Authors</strong><br />
            {authors.join(', ')}
          </p>

          <p>
            <strong>Published</strong><br />
            <time datetime={published.toISOString()}>
              {formattedDate}
            </time>
          </p>

          {
            formattedUpdated && (
              <p>
                <strong>Updated</strong><br />
                <time datetime={updated?.toISOString()}>
                  {formattedUpdated}
                </time>
              </p>
            )
          }

          {
            publicationDetails.length > 0 && (
              <p>
                <strong>Publication</strong><br />
                {publicationDetails.join(' · ')}
              </p>
            )
          }
        </div>

        <div class="publication-actions">
          {
            doi && (
              <a
                href={`https://doi.org/${doi}`}
                target="_blank"
                rel="noreferrer"
              >
                View DOI
              </a>
            )
          }

          {
            url && (
              <a href={url} target="_blank" rel="noreferrer">
                Publisher page
              </a>
            )
          }

          {
            pdf && (
              <a href={pdf} target="_blank" rel="noreferrer">
                Download PDF
              </a>
            )
          }

          {
            repository && (
              <a
                href={repository}
                target="_blank"
                rel="noreferrer"
              >
                Repository
              </a>
            )
          }
        </div>
      </header>

      <div class="publication-content">
        <Content />
      </div>

      {
        citation && (
          <section class="citation-block">
            <h2>Citation</h2>
            <p>{citation}</p>
          </section>
        )
      }

      {
        bibtex && (
          <section class="citation-block">
            <h2>BibTeX</h2>
            <pre><code>{bibtex}</code></pre>
          </section>
        )
      }

      {
        tags.length > 0 && (
          <footer class="publication-footer">
            <h2>Topics</h2>
            <ul>
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </footer>
        )
      }
    </article>
  </main>
</BaseLayout>

<style>
  .publication-page {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 5rem 0;
  }

  article {
    max-width: 52rem;
    margin: 0 auto;
  }

  .publication-header {
    padding-bottom: 3rem;
    border-bottom: 1px solid
      var(--border-color, rgba(191, 164, 105, 0.35));
  }

  .eyebrow {
    color: var(--accent-color, #bfa469);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.75rem 0 1.5rem;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1;
  }

  .abstract {
    font-size: 1.2rem;
    line-height: 1.8;
    opacity: 0.85;
  }

  .publication-meta {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(12rem, 1fr)
    );
    gap: 1rem;
    margin-top: 2rem;
  }

  .publication-meta p {
    margin: 0;
    line-height: 1.6;
  }

  .publication-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .publication-actions a {
    padding: 0.65rem 1rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    text-decoration: none;
  }

  .publication-content {
    margin-top: 3rem;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .publication-content :global(h2) {
    margin-top: 3rem;
  }

  .publication-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .citation-block,
  .publication-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid
      var(--border-color, rgba(191, 164, 105, 0.35));
  }

  pre {
    padding: 1rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    background: rgba(0, 0, 0, 0.25);
  }

  .publication-footer ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .publication-footer li {
    padding: 0.3rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: 999px;
  }
</style>