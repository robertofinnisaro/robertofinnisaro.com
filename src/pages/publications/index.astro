---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';

const publications = (
  await getCollection('publications', ({ data }) => !data.draft)
).sort(
  (a, b) =>
    b.data.published.getTime() - a.data.published.getTime(),
);

const featuredPublications = publications.filter(
  ({ data }) => data.featured,
);

const remainingPublications = publications.filter(
  ({ data }) => !data.featured,
);
---

<BaseLayout
  title="Publications & Research"
  description="Academic publications, technical reports, datasets and long-form research."
>
  <main class="publications-page">
    <header class="page-header">
      <p class="eyebrow">The Archive</p>
      <h1>Publications & Research</h1>

      <p class="intro">
        A record of formal publications, technical reports, conference
        papers, datasets and continuing research.
      </p>
    </header>

    {
      featuredPublications.length > 0 && (
        <section aria-labelledby="featured-publications">
          <h2 id="featured-publications">Selected publications</h2>

          <div class="publication-list">
            {featuredPublications.map((publication) => (
              <PublicationCard publication={publication} />
            ))}
          </div>
        </section>
      )
    }

    <section aria-labelledby="all-publications">
      <h2 id="all-publications">
        {featuredPublications.length > 0
          ? 'Complete archive'
          : 'Publications'}
      </h2>

      {
        remainingPublications.length > 0 ? (
          <div class="publication-list">
            {remainingPublications.map((publication) => (
              <PublicationCard publication={publication} />
            ))}
          </div>
        ) : featuredPublications.length === 0 ? (
          <p>No publications have been added yet.</p>
        ) : null
      }
    </section>
  </main>
</BaseLayout>

<style>
  .publications-page {
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 5rem 0;
  }

  .page-header {
    max-width: 50rem;
    margin-bottom: 4rem;
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--accent-color, #bfa469);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 8vw, 6rem);
    line-height: 0.95;
  }

  .intro {
    margin-top: 1.5rem;
    font-size: 1.15rem;
    line-height: 1.8;
    opacity: 0.85;
  }

  section + section {
    margin-top: 5rem;
  }

  section > h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.6rem, 4vw, 2.5rem);
  }

  .publication-list {
    display: grid;
    gap: 1.25rem;
  }
</style>