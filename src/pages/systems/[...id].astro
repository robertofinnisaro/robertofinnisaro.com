---
import { render } from 'astro:content';

import DocsLayout from '../../layouts/DocsLayout.astro';
import {
  formatDate,
  getChapterLabel,
  getChapters,
  getDocumentRole,
  getEntryUrl,
  getPartLabel,
  getReferenceTypeTitle,
  getSystemEntries,
  getSystemHub,
  getSystemId,
  getBookForSystem,
  isSystemHub,
  type SystemEntry,
} from '../../lib/systems';

export async function getStaticPaths() {
  const entries = await getSystemEntries();

  // Hubs are rendered by [system]/index.astro.
  return entries
    .filter((entry) => !isSystemHub(entry))
    .map((entry) => ({
      params: { id: entry.id },
      props: { entry },
    }));
}

interface Props {
  entry: SystemEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const systemId = getSystemId(entry);
const role = getDocumentRole(entry);
const hub = await getSystemHub(systemId);
const book = role === 'chapter' ? await getBookForSystem(systemId) : undefined;
const base = `/systems/${systemId}`;

const {
  title,
  description,
  published,
  updated,
  estimatedTime,
  difficulty,
  hardware,
  software,
  referenceType,
  tags,
} = entry.data;

const breadcrumbs = [
  { href: '/systems/', label: 'Systems' },
  { href: `${base}/`, label: hub.data.title },
];

let eyebrow = hub.data.title;
let previous: SystemEntry | undefined;
let next: SystemEntry | undefined;

if (role === 'chapter') {
  breadcrumbs.push({ href: `${base}/build-guide/`, label: 'Build Guide' });

  const part = entry.data.part ?? 0;
  eyebrow = part > 0
    ? `${getPartLabel(systemId, part)} · ${getChapterLabel(entry)}`
    : getPartLabel(systemId, part);

  const chapters = getChapters(await getSystemEntries(systemId));
  const index = chapters.findIndex(({ id }) => id === entry.id);
  previous = chapters[index - 1];
  next = chapters[index + 1];
} else if (role === 'reference') {
  breadcrumbs.push({ href: `${base}/reference/`, label: 'Reference' });
  eyebrow = `Reference · ${getReferenceTypeTitle(referenceType)}`;
}
---

<DocsLayout
  title={title}
  description={description}
  systemId={systemId}
  currentId={entry.id}
  breadcrumbs={breadcrumbs}
  eyebrow={eyebrow}
  headings={headings}
>
  <Fragment slot="meta">
    {book && (
      <p class="doc-book">From the book <a href={`/books/${book.id}/`}><em>{book.data.title}</em></a></p>
    )}
    <dl class="doc-meta">
      {role === 'chapter' ? (
        <>
          {estimatedTime && (
            <div><dt>Estimated time</dt><dd>{estimatedTime}</dd></div>
          )}
          {difficulty && (
            <div><dt>Difficulty</dt><dd>{difficulty}</dd></div>
          )}
        </>
      ) : (
        <>
          <div><dt>Published</dt><dd>{formatDate(published)}</dd></div>
          {updated && (
            <div><dt>Updated</dt><dd>{formatDate(updated)}</dd></div>
          )}
        </>
      )}
    </dl>

    {role === 'chapter' && (hardware.length > 0 || software.length > 0) && (
      <div class="doc-requirements">
        {hardware.length > 0 && (
          <div>
            <h2>Hardware</h2>
            <ul>{hardware.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}
        {software.length > 0 && (
          <div>
            <h2>Software</h2>
            <ul>{software.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}
      </div>
    )}
  </Fragment>

  <Content />

  <Fragment slot="after">
    {tags.length > 0 && (
      <div class="meta doc-tags" aria-label="Topics">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}

    {role === 'chapter' && (
      <nav class="doc-pager" aria-label="Chapter navigation">
        {previous ? (
          <a class="doc-pager__link" href={getEntryUrl(previous)} rel="prev">
            <span class="eyebrow">← Previous</span>
            <span>{previous.data.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="doc-pager__link doc-pager__link--next" href={getEntryUrl(next)} rel="next">
            <span class="eyebrow">Next →</span>
            <span>{next.data.title}</span>
          </a>
        )}
      </nav>
    )}

    {role === 'reference' && (
      <p class="doc-back"><a href={`${base}/reference/`}>← All reference documents</a></p>
    )}
  </Fragment>
</DocsLayout>

<style>
  .doc-book { margin: -.4rem 0 0; font-family: var(--serif-text); }
  .doc-book a { color: var(--ink); text-decoration-color: var(--gold); }
  .doc-meta { display: flex; flex-wrap: wrap; gap: 2rem; margin: 1.5rem 0 0; }
  .doc-meta:empty { display: none; }
  .doc-meta dt { color: var(--gold); font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; }
  .doc-meta dd { margin: .2rem 0 0; }
  .doc-requirements { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1.5rem; margin-top: 1.8rem; padding: 1.2rem 1.4rem; border: 1px solid var(--line); background: var(--panel); }
  .doc-requirements h2 { margin: 0 0 .4rem; font-size: 1.3rem; }
  .doc-requirements ul { margin: 0; padding-left: 1.1rem; color: var(--muted); font-size: .92rem; }
  .doc-tags { margin-top: 3rem; }
  .doc-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .doc-pager__link { display: flex; flex-direction: column; gap: .3rem; padding: 1.1rem 1.2rem; border: 1px solid var(--line); text-decoration: none; transition: .25s ease; }
  .doc-pager__link:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .doc-pager__link .eyebrow { margin: 0; }
  .doc-pager__link span:last-child { font-family: var(--serif-display); font-size: 1.35rem; font-weight: 600; }
  .doc-pager__link--next { text-align: right; }
  .doc-back { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  @media (max-width: 600px) { .doc-pager { grid-template-columns: 1fr; } .doc-pager__link--next { text-align: left; } }
</style>
